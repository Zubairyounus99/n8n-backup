uest.com',\\n  'bbb.org',\\n  'angi.com',\\n  'homeadvisor.com',\\n  'thumbtack.com',\\n  'trustpilot.com',\\n  'wikipedia.org'\\n];\\n\\nfunction isBlocked(hostname) {\\n  hostname = hostname.toLowerCase().replace(/^www\\\\./, '');\\n\\n  return blockedDomains.some(domain =>\\n    hostname === domain || hostname.endsWith('.' + domain)\\n  );\\n}\\n\\nfunction cleanUrl(raw) {\\n\\n  if (!raw || typeof raw !== 'string') {\\n    return null;\\n  }\\n\\n  let url = raw.trim();\\n\\n  // Decode common HTML entities\\n  url = url\\n    .replace(/&amp;/gi, '&')\\n    .replace(/\\\\\\\\u003d/gi, '=')\\n    .replace(/\\\\\\\\u0026/gi, '&')\\n    .replace(/\\\\\\\\u002f/gi, '/')\\n    .replace(/&quot;/gi, '\\\"');\\n\\n  // Remove surrounding characters\\n  url = url.replace(/^[(\\\"'`<\\\\[]+/, '');\\n  url = url.replace(/[)\\\"'`>\\\\],;]+$/, '');\\n\\n  // Only HTTP/HTTPS\\n  if (!/^https?:\\\\/\\\\//i.test(url)) {\\n    return null;\\n  }\\n\\n  let parsed;\\n\\n  try {\\n    parsed = new URL(url);\\n  } catch {\\n    return null;\\n  }\\n\\n  // Only normal web URLs\\n  if (\\n    parsed.protocol !== 'http:' &&\\n    parsed.protocol !== 'https:'\\n  ) {\\n    return null;\\n  }\\n\\n  const hostname = parsed.hostname\\n    .toLowerCase()\\n    .replace(/^www\\\\./, '');\\n\\n  // Must have a real domain\\n  if (!hostname || !hostname.includes('.')) {\\n    return null;\\n  }\\n\\n  // Reject IP addresses\\n  if (/^\\\\d{1,3}(\\\\.\\\\d{1,3}){3}$/.test(hostname)) {\\n    return null;\\n  }\\n\\n  // Reject Google and other non-business domains\\n  if (isBlocked(hostname)) {\\n    return null;\\n  }\\n\\n  // Reject obvious Google paths\\n  const fullUrl = parsed.href.toLowerCase();\\n\\n  if (\\n    fullUrl.includes('google.com/') ||\\n    fullUrl.includes('googleapis.com/') ||\\n    fullUrl.includes('gstatic.com/') ||\\n    fullUrl.includes('googleusercontent.com/') ||\\n    fullUrl.includes('/maps/')\\n  ) {\\n    return null;\\n  }\\n\\n  // Remove tracking parameters