ation and footer\\n  text = text\\n    .replace(/<nav\\\\b[^>]*>[\\\\s\\\\S]*?<\\\\/nav>/gi, '')\\n    .replace(/<footer\\\\b[^>]*>[\\\\s\\\\S]*?<\\\\/footer>/gi, '')\\n    .replace(/<header\\\\b[^>]*>[\\\\s\\\\S]*?<\\\\/header>/gi, '');\\n\\n  // Create readable line breaks\\n  text = text\\n    .replace(/<\\\\/(p|div|section|article|main|h1|h2|h3|h4|h5|li)>/gi, '\\\\n')\\n    .replace(/<(br|hr)\\\\s*\\\\/?>/gi, '\\\\n');\\n\\n  // Remove remaining HTML tags\\n  text = text.replace(/<[^>]+>/g, ' ');\\n\\n  // Decode common entities\\n  text = text\\n    .replace(/&nbsp;/gi, ' ')\\n    .replace(/&amp;/gi, '&')\\n    .replace(/&quot;/gi, '\\\"')\\n    .replace(/&#39;/gi, \\\"'\\\")\\n    .replace(/&lt;/gi, '<')\\n    .replace(/&gt;/gi, '>');\\n\\n  // Clean whitespace\\n  text = text\\n    .replace(/\\\\r/g, '')\\n    .replace(/[ \\\\t]+/g, ' ')\\n    .replace(/\\\\n\\\\s*\\\\n\\\\s*\\\\n+/g, '\\\\n\\\\n')\\n    .trim();\\n\\n  return text;\\n}\\n\\nfunction removeNoise(text) {\\n  const lines = text\\n    .split('\\\\n')\\n    .map(line => line.trim())\\n    .filter(Boolean);\\n\\n  const noisePatterns = [\\n    /^cookie/i,\\n    /accept cookies/i,\\n    /privacy policy/i,\\n    /terms of service/i,\\n    /terms and conditions/i,\\n    /^login$/i,\\n    /^sign in$/i,\\n    /^sign up$/i,\\n    /^subscribe$/i,\\n    /^menu$/i,\\n    /^search$/i,\\n    /^home$/i,\\n    /^copyright/i,\\n    /all rights reserved/i,\\n    /enable javascript/i\\n  ];\\n\\n  const seen = new Set();\\n  const useful = [];\\n\\n  for (const line of lines) {\\n    if (line.length < 3) continue;\\n\\n    if (noisePatterns.some(pattern => pattern.test(line))) {\\n      continue;\\n    }\\n\\n    const normalized = line\\n      .toLowerCase()\\n      .replace(/\\\\s+/g, ' ')\\n      .trim();\\n\\n    if (seen.has(normalized)) continue;\\n\\n    seen.add(normalized);\\n    useful.push(line);\\n  }\\n\\n  return useful.join('\\\\n');\\n}\\n\\nfunction limitText(text, maxChars) {\\n  if (text.length